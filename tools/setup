#!/usr/bin/env bash
# Prepares a fresh clone: checks Godot, installs dev tools into .venv (D-004).
# Safe to run again: it changes nothing once the clone is set up.
set -euo pipefail

# shellcheck source=tools/_godot.sh
source "$(dirname "${BASH_SOURCE[0]}")/_godot.sh"
cd "$PROJECT_ROOT"

if ! command -v python3 >/dev/null 2>&1; then
	echo "error: python3 not found. Install Python 3 and run tools/setup again." >&2
	exit 1
fi

godot="$(resolve_godot)"
godot_version="$("$godot" --version | head -n 1)"
case "$godot_version" in
	"$REQUIRED_GODOT_VERSION"*) ;;
	*)
		echo "error: Godot $REQUIRED_GODOT_VERSION required, found $godot_version ($godot)." >&2
		echo "  Install it, or point GODOT_BIN at the right binary." >&2
		exit 1
		;;
esac

if [ ! -x .venv/bin/python ]; then
	python3 -m venv .venv
fi
.venv/bin/python -m pip install --quiet --disable-pip-version-check -r requirements-dev.txt

# A fresh clone has no .godot/ yet, and GUT needs the class cache it holds.
godot_import "$godot"

echo "setup ok: Godot $godot_version, $(.venv/bin/gdlint --version)"
